# Скопируйте в .env и заполните три пароля ниже.

# --- Пароли (обязательно) ---
# Пустые значения не подменяются дефолтами — стек не запустится.
PZ_ADMIN_PASSWORD=
PZ_RCON_PASSWORD=
GF_SECURITY_ADMIN_PASSWORD=

# --- Сервер ---
# PZ_SERVER_NAME задаёт и имя конфига: data/Zomboid/Server/<имя>.ini
PZ_SERVER_NAME=zomboid-server
PZ_SERVER_WELCOME_MESSAGE=Welcome to Project Zomboid!
PZ_MAX_PLAYERS=
PZ_PUBLIC=false
# Пароль на вход. Пусто — открытый сервер.
PZ_SERVER_PASSWORD=
# Язык серверных текстов (радио, ТВ): EN, RU, DE, FR, ES, PT
PZ_LANGUAGE=RU

# --- Порты ---
# Игровые порты открыты наружу, RCON слушает только loopback.
PZ_PORT=16261
PZ_UDP_PORT=16262
PZ_RCON_PORT=27015

# --- Память ---
# Куча JVM под хост с 24 ГБ. На меньшей машине снижайте оба значения:
# сверх кучи JVM берёт ещё около 3 ГБ, плюс ОС и мониторинг.
PZ_JVM_XMS=10g
PZ_JVM_XMX=15g

# --- Ежедневное обслуживание ---
# Предупреждение игрокам, сохранение, бэкап, перезапуск.
# Часовой пояс применяет планировщик, таймзона хоста на расписание не влияет.
MAINTENANCE_TIME=14:00
MAINTENANCE_TZ=Europe/Moscow
# Архивы в ./backups старше этого срока удаляются.
BACKUP_KEEP_DAYS=3
# Предел на время архивации, секунды. Дольше — прервать и записать сбой.
BACKUP_TIMEOUT=900

# --- Grafana ---
# Должен совпадать с адресом, по которому вы открываете Grafana.
GF_SERVER_ROOT_URL=https://localhost:3000

# --- SteamCMD ---
# Сверять файлы сервера с манифестом Steam при каждом старте.
# Стоит гигабайты ввода-вывода, модов не касается. Включать для починки файлов.
PZ_VALIDATE=false