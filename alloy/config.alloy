local.file_match "pz_console" {
	path_targets = [{
		"__path__" = "/logs/server-console.txt",
		"job"      = "zomboid",
	}]
	sync_period = "10s"
}

loki.source.file "pz_console" {
	targets       = local.file_match.pz_console.targets
	forward_to    = [loki.write.local.receiver]
	tail_from_end = true
}

loki.write "local" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
